{
  "name": "dsh-one-sync",
  "version": "1.1.0",
  "description": "DSH 一键同步：Git 代码拉取/推送 + DSH 状态（sessions/storages/memories）加密上传/拉取；侧栏按钮与设置页配置。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "release": "node scripts/release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zroNzero/dsh-one-sync.git"
  },
  "homepage": "https://github.com/zroNzero/dsh-one-sync#readme",
  "bugs": {
    "url": "https://github.com/zroNzero/dsh-one-sync/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "sync",
    "github",
    "encryption"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
