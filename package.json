{
  "name": "dsh-one-sync",
  "version": "0.1.2",
  "description": "DSH 一键同步：Git 代码拉取/推送 + DSH 状态（sessions/storages/memories）加密上传/拉取；侧栏按钮与设置页配置。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "sync",
    "github",
    "encryption"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
